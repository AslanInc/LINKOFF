{
  "manifest_version": 3,
  "name": "LinkOff – Bulk LinkedIn Disconnect",
  "version": "1.0.0",
  "description": "Remove LinkedIn connections you don't know with one button, instead of clicking through each one.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_title": "LinkOff",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
